# Verified 2026-11-13 against the live site:
#   curl -sI https://ds-da.ca/games/dropblock/leaderboard.json
#   → server: cloudflare
#   → cache-control: max-age=600        <- GitHub Pages' default, NOT the rule below
#   → cf-cache-status: DYNAMIC          <- Cloudflare is not caching these at all
#
# ds-da.ca is served by GitHub Pages (see CNAME) behind the Cloudflare proxy.
# GitHub Pages ignores _headers — it is a Cloudflare Pages / Netlify convention.
# So neither the old dropblock-only rule nor the widened one below has ever
# taken effect. Do not reach for this file to fix a caching problem; it cannot.
#
# If leaderboards ever DO need edge cache control, do it as a Cloudflare
# Cache Rule in the dashboard, or move hosting to Cloudflare Pages — at which
# point the rule below starts working as written.
/games/:game/leaderboard.json
  Cache-Control: no-cache, must-revalidate
